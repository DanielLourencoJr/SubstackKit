# Copy this file to .env and fill in credentials locally. Never commit real credentials.
SUBSTACK_SID=s:your_substack_session_cookie_here

# Optional default sync folder for `substack sync` (write side).
# Override per-run with --dir; precedence: --dir > SUBSTACK_SYNC_DIR > ./Articles
# SUBSTACK_SYNC_DIR=/path/to/Sync

# Credential resolution (lib/credentials.js) tries, in order:
#   1. --env <file>            explicit file for this run
#   2. $SUBSTACK_CREDENTIALS_FILE          (written by install.sh)
#   3. ~/.config/substack/credentials.env  (symlink created by install.sh)
#   4. <projectsRoot>/.substack-credentials.env  (central store; TEST preferred)
#   5. <projectsRoot>/.substack.test.env
#   6. <repo>/.env and ./.env
# Writes default to the TEST account; MAIN is never auto-selected.
